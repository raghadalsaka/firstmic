# First Mic production settings: copy to /opt/firstmic/.env on the droplet (chmod 600). Never commit the real file.

# Cloudflare Zero Trust > Networks > Tunnels > firstmic-prod > the token from the cloudflared install command.
CLOUDFLARE_TUNNEL_TOKEN=

# Teacher sign-in: QuestRush's Google OAuth client ID (docs/DEPLOYMENT.md). The image is built with the same value
# from the GitHub variable VITE_GOOGLE_CLIENT_ID; the server reads it here to check Google sign-ins.
VITE_GOOGLE_CLIENT_ID=

# Optional (defaults in brackets).
#FIRSTMIC_MAX_SECONDS=180
#LOG_LEVEL=info
#FIRSTMIC_GROUP_UPLOAD_MINUTES=5
# Live-call STUN/TURN servers as JSON [Google STUN]
#ICE_SERVERS=
#PIN_MAX_ATTEMPTS=5
#PIN_LOCK_MINUTES=15
# Behind the tunnel every request comes from cloudflared's address, so this limit counts the whole site.
#PIN_ATTEMPTS_PER_MINUTE_PER_IP=30
