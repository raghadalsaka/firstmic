# First Mic configuration. Copy to .env next to docker-compose.yml.
# docker compose reads .env itself; the Node server does not load it when run directly.

# Public domain Caddy serves with automatic HTTPS (DNS A record must point at the server).
FIRSTMIC_DOMAIN=firstmic.example.com

# Teacher sign-in: the same Google OAuth client and value as QuestRush's .env (docs/DEPLOYMENT.md). Not a secret.
# Any Google account can sign in as a teacher. Sign-in is off when this is empty.
VITE_GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com

# Recording length limit in seconds (students' takes auto-stop here; the server also trims to it).
#FIRSTMIC_MAX_SECONDS=180

# Fastify log level: fatal | error | warn | info | debug | trace
#LOG_LEVEL=info

# Student PINs: wrong PINs before a student is locked out, and for how long (minutes).
#PIN_MAX_ATTEMPTS=5
#PIN_LOCK_MINUTES=15
# PIN sign-ins and group joins allowed per minute from one IP address. Behind Caddy every request comes from Caddy's
# address, so this is effectively a limit for the whole site.
#PIN_ATTEMPTS_PER_MINUTE_PER_IP=30

# --- Running the server without Docker ---
#PORT=4100
# Where the database, uploaded chunks and submission MP3s live. Defaults to ./data at the repo root.
#FIRSTMIC_DATA_DIR=/var/lib/firstmic
# ffmpeg/ffprobe binaries; default to the ones on PATH.
#FFMPEG_PATH=/usr/bin/ffmpeg
#FFPROBE_PATH=/usr/bin/ffprobe

# Two-person podcasts: after Stop, how long the server waits for both voices before the take fails (minutes).
#FIRSTMIC_GROUP_UPLOAD_MINUTES=5

# Two-person podcasts: the live call's ICE servers. Defaults to Google's public STUN servers. Some school Wi-Fi and
# mobile networks need a TURN relay as well; you'd run that yourself, e.g. coturn:
#ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"firstmic","credential":"..."}]

# --- Tributary settings First Mic doesn't use ---
#LIVEKIT_URL=wss://your-livekit-host
#LIVEKIT_API_KEY=
#LIVEKIT_API_SECRET=
#WHISPER_CLI=whisper-cli
#WHISPER_MODEL=/path/to/ggml-base.bin
